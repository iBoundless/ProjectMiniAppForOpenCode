# Права файла: chmod 600. Не коммитить заполненную копию.

# Telegram: токен того же бота, через которого открывается Mini App.
TELEGRAM_BOT_TOKEN=
# Числовые ID Telegram через запятую.
ALLOWED_USER_IDS=

# OpenCode: только локальный адрес. Пароль берется из service.json,
# OPENCODE_PASSWORD нужен, только если service.json недоступен.
OPENCODE_URL=http://127.0.0.1:49374
OPENCODE_SERVICE_JSON=~/.config/opencode/service.json
# OPENCODE_PASSWORD=
# OPENCODE_BIN=opencode

# Общая база бота (та же, что у opencode-telegram-bot).
OCBOT_DB_PATH=/var/lib/opencode-telegram-bot/bot.db

# Mini App. MINI_APP_HOST - внутренний адрес, на который проксирует Caddy.
MINI_APP_HOST=127.0.0.1
MINI_APP_PORT=8080
# Публичный адрес панели: Origin для CSRF и ссылки входа для Safari.
MINI_APP_URL=https://panel.example.com
MINI_APP_DB_PATH=/var/lib/opencode-telegram-bot/mini_app.db
MINI_APP_INIT_DATA_MAX_AGE=86400
MINI_APP_SESSION_TTL=86400
# Каталог собранного frontend; по умолчанию frontend/dist рядом с backend.
# MINI_APP_STATIC_DIR=/opt/opencode-miniapp/frontend/dist
# MINI_APP_LOG_LEVEL=INFO
